    },
    "Prioritize the first and last pieces of each selected file, then use the chosen download order.": {
      "comment": "SeedHop macOS UI (ImportView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erste und letzte Teile jeder ausgewählten Datei priorisieren, danach die gewählte Downloadreihenfolge verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritize the first and last pieces of each selected file, then use the chosen download order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da prioridad a las primeras y últimas piezas de cada archivo seleccionado y después usa el orden de descarga elegido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne la priorité aux premiers et derniers blocs de chaque fichier sélectionné, puis utilise l’ordre de téléchargement choisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai priorità alle parti iniziali e finali di ogni file selezionato, poi usa l’ordine di download scelto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した各ファイルの最初と最後のピースを優先し、その後は選択した順序でダウンロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 각 파일의 처음과 마지막 조각을 우선한 다음 선택한 다운로드 순서를 따릅니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadaj priorytet pierwszym i ostatnim częściom każdego wybranego pliku, a potem stosuj wybraną kolejność pobierania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorizar os primeiros e últimos blocos de cada arquivo selecionado e depois usar a ordem de download escolhida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдавать приоритет первым и последним частям каждого выбранного файла, затем использовать выбранный порядок загрузки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili her dosyanın ilk ve son parçalarına öncelik ver, ardından seçili indirme sırasını kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надавати пріоритет першим і останнім частинам кожного вибраного файлу, а потім використовувати вибраний порядок завантаження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先下载所选文件的首尾分片，然后按选定的下载顺序进行。"
          }
        }
      }
    },
