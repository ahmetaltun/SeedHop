    "Start before other waiting downloads. Active downloads keep their slots.": {
      "comment": "SeedHop macOS UI (ImportView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor anderen wartenden Downloads starten. Aktive Downloads behalten ihre Plätze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start before other waiting downloads. Active downloads keep their slots."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia antes que otras descargas en espera. Las descargas activas conservan sus plazas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre avant les autres téléchargements en attente. Les téléchargements actifs gardent leur place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia prima degli altri download in attesa. I download attivi mantengono i propri slot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機中の他のダウンロードより先に開始します。実行中のダウンロードは枠を保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 대기 중인 다운로드보다 먼저 시작합니다. 활성 다운로드는 자리를 유지합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocznij przed innymi oczekującymi pobieraniami. Aktywne pobierania zachowują swoje miejsca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar antes de outros downloads em espera. Downloads ativos mantêm suas vagas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начать раньше других ожидающих загрузок. Активные загрузки сохраняют свои места."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleyen diğer indirmelerden önce başlat. Etkin indirmeler yuvalarını korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почати раніше за інші завантаження, що очікують. Активні завантаження зберігають свої місця."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他等待中的下载之前开始。活动下载保留其名额。"
          }
        }
      }
    },
