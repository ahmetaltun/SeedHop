            "state": "translated",
            "value": "No se notifican conexiones con pares. Esto no demuestra un fallo del tracker ni de la red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune connexion à un pair n’est signalée. Cela ne prouve pas une défaillance du tracker ou du réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono segnalate connessioni ai peer. Questo non dimostra un errore del tracker o della rete."
