    "Paste a magnet link beginning with magnet:, or open a .torrent file.": {
      "comment": "SeedHop macOS UI (ImportSession.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen mit magnet: beginnenden Magnet-Link ein oder öffne eine .torrent-Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a magnet link beginning with magnet:, or open a .torrent file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega un enlace magnet que empiece por magnet: o abre un archivo .torrent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez un lien magnet commençant par magnet: ou ouvrez un fichier .torrent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla un link magnet che inizia con magnet: oppure apri un file .torrent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "magnet:で始まるマグネットリンクを貼り付けるか、.torrentファイルを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "magnet:으로 시작하는 마그넷 링크를 붙여넣거나 .torrent 파일을 여세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej link magnet zaczynający się od magnet: lub otwórz plik .torrent."
          }
        },
        "pt-BR": {
