            "state": "translated",
            "value": "エンジンがこの転送を停止しました。%@ エラーが再発する場合は詳細を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엔진이 이 전송을 중지했습니다. %@ 오류가 다시 발생하면 세부사항을 확인하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Silnik zatrzymał ten transfer. %@ Jeśli błąd się powtórzy, sprawdź szczegóły."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mecanismo interrompeu esta transferência. %@ Veja os detalhes se o erro voltar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Движок остановил эту передачу. %@ Если ошибка повторится, просмотрите подробности."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motor bu aktarımı durdurdu. %@ Hata tekrarlanırsa ayrıntıları inceleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
