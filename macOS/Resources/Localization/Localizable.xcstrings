    "Try another name or clear the search.": {
      "comment": "SeedHop macOS UI (TorrentFilesView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche einen anderen Namen oder lösche die Suche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try another name or clear the search."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba otro nombre o borra la búsqueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez un autre nom ou effacez la recherche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova un altro nome o cancella la ricerca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の名前を試すか、検索をクリアしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 이름을 시도하거나 검색을 지우세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypróbuj inną nazwę lub wyczyść wyszukiwanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente outro nome ou limpe a busca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте другое имя или очистите поиск."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir ad deneyin veya aramayı temizleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте інше ім’я або очистіть пошук."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请尝试其他名称或清除搜索。"
          }
        }
      }
    },
    "Try another tracker or clear your filters.": {
      "comment": "SeedHop macOS UI (LibraryView.swift).",
