          }
        }
      }
    },
    "Try encryption first. Plaintext connections are still allowed if encryption fails.": {
      "comment": "SeedHop macOS UI (Models.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst Verschlüsselung versuchen. Klartextverbindungen sind weiterhin erlaubt, falls die Verschlüsselung fehlschlägt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try encryption first. Plaintext connections are still allowed if encryption fails."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba primero con cifrado. Las conexiones sin cifrar siguen permitidas si falla el cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie d’abord le chiffrement. Les connexions en clair restent autorisées si le chiffrement échoue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova prima la crittografia. Le connessioni in chiaro sono comunque consentite se la crittografia non riesce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化を先に試します。暗号化に失敗した場合は平文の接続も許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화를 먼저 시도합니다. 암호화에 실패하면 평문 연결도 허용합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw próbuj szyfrowania. Jeśli się nie powiedzie, połączenia jawne nadal są dozwolone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentar criptografia primeiro. Conexões em texto simples ainda são permitidas se a criptografia falhar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала пробовать шифрование. Если оно не сработает, подключения открытым текстом по-прежнему разрешены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce şifrelemeyi dene. Şifreleme başarısız olursa düz metin bağlantılarına yine izin verilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку пробувати шифрування. Якщо воно не спрацює, підключення відкритим текстом залишаються дозволеними."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先尝试加密。如果加密失败，仍允许明文连接。"
          }
        }
      }
    },
    "Two files cannot share a path or contain one another.": {
      "comment": "SeedHop macOS UI (EngineMessage.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Dateien dürfen weder denselben Pfad haben noch ineinander verschachtelt sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two files cannot share a path or contain one another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos archivos no pueden compartir una ruta ni contenerse entre sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux fichiers ne peuvent pas partager un chemin ni être imbriqués l’un dans l’autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due file non possono condividere un percorso né essere contenuti l’uno nell’altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つのファイルで同じパスを使ったり、一方のパスに他方を含めたりすることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 파일은 경로를 공유하거나 서로를 포함할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa pliki nie mogą mieć tej samej ścieżki ani zawierać się wzajemnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois arquivos não podem compartilhar um caminho ou conter um ao outro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два файла не могут иметь общий путь или содержать друг друга."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki dosya aynı yolu paylaşamaz veya biri diğerini içeremez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Два файли не можуть мати спільний шлях або містити один одного."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个文件不能共用路径，也不能互相包含。"
          }
        }
      }
    },
