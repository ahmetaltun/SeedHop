    "Restore read and write access to the saved folder, then retry. %@": {
      "comment": "SeedHop macOS UI (TransferPresentation.swift). Preserve placeholder types and positions; use positional placeholders when reordering. Text arguments may be verbatim user names, paths, or formatted quantities.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle Lese- und Schreibzugriff auf den gespeicherten Ordner wieder her und versuche es erneut. %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore read and write access to the saved folder, then retry. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura el acceso de lectura y escritura a la carpeta guardada y vuelve a intentarlo. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablissez l’accès en lecture et en écriture au dossier enregistré, puis réessayez. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina l’accesso in lettura e scrittura alla cartella salvata, poi riprova. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したフォルダの読み書き権限を復元してから、もう一度お試しください。%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 폴더의 읽기 및 쓰기 접근 권한을 복원한 다음 다시 시도하세요. %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywróć dostęp do odczytu i zapisu zapisanego folderu, a następnie spróbuj ponownie. %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure o acesso de leitura e gravação à pasta salva e tente novamente. %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановите доступ на чтение и запись к сохранённой папке, затем повторите попытку. %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmiş klasöre okuma ve yazma erişimini geri yükleyip yeniden deneyin. %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновіть доступ на читання й запис до збереженої папки, а потім повторіть спробу. %@"
