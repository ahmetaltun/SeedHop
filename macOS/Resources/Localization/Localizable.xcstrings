        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎已停止此传输。%@ 如果错误再次出现，请查看详情。"
          }
        }
      }
    },
    "The engine took too long to respond. Your library has been preserved.": {
      "comment": "SeedHop macOS UI (EngineClient.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Engine hat zu lange nicht geantwortet. Deine Mediathek wurde beibehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine took too long to respond. Your library has been preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor tardó demasiado en responder. Se ha conservado tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur a mis trop de temps à répondre. Votre bibliothèque a été conservée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore ha impiegato troppo tempo a rispondere. La libreria è stata conservata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンの応答がタイムアウトしました。ライブラリは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엔진 응답 시간이 초과되었습니다. 라이브러리는 보존되었습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Silnik zbyt długo nie odpowiadał. Twoja biblioteka została zachowana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mecanismo demorou demais para responder. Sua biblioteca foi preservada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Движок слишком долго не отвечал. Ваша библиотека сохранена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motorun yanıt vermesi çok uzun sürdü. Kitaplığınız korundu."
