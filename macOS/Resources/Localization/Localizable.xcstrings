    "%@. Review the retained-file cleanup above before changing files.": {
      "comment": "SeedHop macOS UI (TransferPresentation.swift). Preserve placeholder types and positions; use positional placeholders when reordering. Text arguments may be verbatim user names, paths, or formatted quantities.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Prüfe den Hinweis zur Bereinigung beibehaltener Dateien oben, bevor du Dateien änderst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Review the retained-file cleanup above before changing files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Revisa el aviso de limpieza de archivos conservados antes de modificar archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Consultez l’avis de nettoyage des fichiers conservés ci-dessus avant de modifier des fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Controlla l’avviso di pulizia dei file conservati sopra prima di modificare i file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。ファイルを変更する前に、上の保持ファイルの通知を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 파일을 변경하기 전에 위의 보관 파일 정리 알림을 확인하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Sprawdź powyższy komunikat o czyszczeniu zachowanych plików."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Revise o aviso de limpeza acima antes de alterar os arquivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Просмотрите уведомление об очистке сохранённых файлов выше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Yukarıdaki korunan dosyaları temizleme bildirimini inceleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Перегляньте повідомлення про очищення збережених файлів вище."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。更改文件前，请查看上方的保留文件清理通知。"
          }
        }
      }
    },
