    "Lifetime uploaded payload divided by downloaded payload. Unknown history and zero downloads have no ratio.": {
      "comment": "SeedHop macOS UI (NativeTransferGrid.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Insgesamt hochgeladene Nutzdaten geteilt durch heruntergeladene Nutzdaten. Bei unbekanntem Verlauf oder null Downloads gibt es kein Verhältnis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lifetime uploaded payload divided by downloaded payload. Unknown history and zero downloads have no ratio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos útiles subidos durante toda la vida divididos por los descargados. No hay proporción con un historial desconocido o sin descargas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données utiles envoyées au total divisées par les données téléchargées. Aucun ratio si l’historique est inconnu ou si le téléchargement est nul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati utili caricati complessivamente divisi per quelli scaricati. Il rapporto non è disponibile con cronologia sconosciuta o nessun download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "累計アップロード量を累計ダウンロード量で割った値です。履歴不明またはダウンロード量が0の場合は比率を表示しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누적 업로드 페이로드를 다운로드 페이로드로 나눈 값입니다. 기록이 없거나 다운로드가 0이면 비율이 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stosunek wysłanych danych użytkowych do pobranych od początku. Przy nieznanej historii lub zerowym pobieraniu współczynnik jest niedostępny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Payload enviado total dividido pelo payload baixado. Histórico desconhecido e zero downloads não têm proporção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отношение отданных полезных данных к загруженным за всё время. При неизвестной истории или нулевой загрузке коэффициент не определён."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplam yüklenen veri / indirilen veri. Geçmiş bilinmiyorsa veya indirme yoksa oran gösterilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відношення відданих корисних даних до завантажених за весь час. За невідомої історії або нульового завантаження коефіцієнт не визначено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "累计上传有效载荷除以下载有效载荷。历史未知或下载量为零时无分享率。"
          }
        }
      }
    },
    "Limit must be a whole number from 0 to 4,294,967.": {
      "comment": "SeedHop macOS UI (BandwidthSettingsView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Limit muss eine ganze Zahl zwischen 0 und 4.294.967 sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit must be a whole number from 0 to 4,294,967."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite debe ser un número entero entre 0 y 4.294.967."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite doit être un entier de 0 à 4 294 967."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il limite deve essere un numero intero da 0 a 4.294.967."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限は0〜4,294,967の整数で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한은 0~4,294,967 사이의 정수여야 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit musi być liczbą całkowitą od 0 do 4 294 967."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite deve ser um número inteiro de 0 a 4.294.967."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничение должно быть целым числом от 0 до 4 294 967."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınır, 0 ile 4.294.967 arasında bir tam sayı olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обмеження має бути цілим числом від 0 до 4 294 967."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限制必须是 0 到 4,294,967 之间的整数。"
          }
        }
      }
    },
    "Limits apply across all transfers. Use 0 for unlimited.": {
      "comment": "SeedHop macOS UI (BandwidthSettingsView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits gelten für alle Übertragungen zusammen. Verwende 0 für unbegrenzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits apply across all transfers. Use 0 for unlimited."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los límites se aplican al conjunto de transferencias. Usa 0 para no limitar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les limites s’appliquent à l’ensemble des transferts. Utilisez 0 pour illimité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I limiti si applicano all’insieme dei trasferimenti. Usa 0 per nessun limite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限はすべての転送に適用されます。0は無制限です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한은 모든 전송에 적용됩니다. 무제한으로 설정하려면 0을 사용하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limity dotyczą wszystkich transferów. Użyj 0, aby wyłączyć limit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os limites se aplicam a todas as transferências. Use 0 para não limitar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничения действуют на все передачи. Используйте 0, чтобы снять ограничение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırlar tüm aktarımlar için geçerlidir. Sınırsız için 0 kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обмеження діють на всі передавання. Використовуйте 0, щоб зняти обмеження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限制应用于所有传输。0 表示不限速。"
          }
        }
      }
    },
