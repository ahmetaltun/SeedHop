    "Set an alternative download or upload limit before enabling alternative limits.": {
      "comment": "SeedHop macOS UI (EngineMessage.swift, LibraryStore.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege ein alternatives Download- oder Uploadlimit fest, bevor du alternative Limits aktivierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set an alternative download or upload limit before enabling alternative limits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece un límite alternativo de descarga o subida antes de activar los límites alternativos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez une limite alternative de téléchargement ou d’envoi avant d’activer les limites alternatives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta un limite alternativo di download o upload prima di abilitare i limiti alternativi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代替制限を有効にする前に、代替のダウンロードまたはアップロード制限を設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대체 제한을 활성화하기 전에 대체 다운로드 또는 업로드 제한을 설정하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed włączeniem alternatywnych limitów ustaw alternatywny limit pobierania lub wysyłania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina um limite alternativo de download ou upload antes de ativar os limites alternativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед включением альтернативных ограничений задайте альтернативное ограничение загрузки или отдачи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternatif sınırları etkinleştirmeden önce alternatif bir indirme veya yükleme sınırı ayarlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перш ніж увімкнути альтернативні обмеження, задайте альтернативне обмеження завантаження або віддавання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用备用限制前，请先设置备用下载或上传限制。"
          }
        }
      }
    },
    "Set and save a download or upload limit above 0 to enable the switch.": {
      "comment": "SeedHop macOS UI (BandwidthSettingsView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege ein Download- oder Uploadlimit größer als 0 fest und speichere es, um den Schalter zu aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set and save a download or upload limit above 0 to enable the switch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece y guarda un límite de descarga o subida superior a 0 para activar el interruptor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez et enregistrez une limite de téléchargement ou d’envoi supérieure à 0 pour activer le commutateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta e salva un limite di download o upload maggiore di 0 per abilitare l’interruttore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイッチを有効にするには、0より大きいダウンロードまたはアップロード制限を設定して保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스위치를 활성화하려면 0보다 큰 다운로드 또는 업로드 제한을 설정하고 저장하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby włączyć przełącznik, ustaw i zapisz limit pobierania lub wysyłania większy od 0."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina e salve um limite de download ou upload acima de 0 para ativar o botão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы включить переключатель, задайте и сохраните ограничение загрузки или отдачи больше 0."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarı etkinleştirmek için 0’dan büyük bir indirme veya yükleme sınırı ayarlayıp kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб увімкнути перемикач, задайте й збережіть обмеження завантаження або віддавання більше 0."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置并保存大于 0 的下载或上传限制，即可启用开关。"
          }
        }
      }
    },
