          "stringUnit": {
            "state": "translated",
            "value": "Scegli almeno un giorno per ogni fascia e inserisci gli orari come HH:mm, da 00:00 a 23:59."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各時間帯に曜日を1つ以上選択し、00:00〜23:59の時刻をHH:mm形式で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 시간대에 요일을 하나 이상 선택하고 00:00~23:59의 시간을 HH:mm 형식으로 입력하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz co najmniej jeden dzień dla każdego przedziału i podaj czas w formacie HH:mm, od 00:00 do 23:59."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha pelo menos um dia para cada intervalo e informe horários como HH:mm, de 00:00 a 23:59."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите хотя бы один день для каждого интервала и введите время в формате HH:mm от 00:00 до 23:59."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman aralığı için en az bir gün seçin ve saatleri 00:00 ile 23:59 arasında HH:mm biçiminde girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть принаймні один день для кожного інтервалу та введіть час у форматі HH:mm від 00:00 до 23:59."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请为每个时间段至少选择一天，并以 HH:mm 格式输入 00:00 至 23:59 之间的时间。"
          }
        }
      }
    },
