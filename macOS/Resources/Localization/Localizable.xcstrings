    "Actions apply to the selected transfers. Select one transfer to inspect its diagnostics.": {
      "comment": "SeedHop macOS UI (LibraryView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktionen gelten für ausgewählte Übertragungen. Wähle eine Übertragung aus, um ihre Diagnose anzusehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions apply to the selected transfers. Select one transfer to inspect its diagnostics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones se aplican a las transferencias seleccionadas. Selecciona una para consultar su diagnóstico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions s’appliquent aux transferts sélectionnés. Sélectionnez un transfert pour consulter son diagnostic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le azioni si applicano ai trasferimenti selezionati. Seleziona un trasferimento per consultarne la diagnostica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作は選択した転送に適用されます。診断情報を確認するには、転送を1件選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업은 선택한 전송에 적용됩니다. 진단 정보를 보려면 전송 하나를 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działania dotyczą wybranych transferów. Wybierz jeden transfer, aby przejrzeć jego diagnostykę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As ações se aplicam às transferências selecionadas. Selecione uma transferência para inspecionar o diagnóstico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действия применяются к выбранным передачам. Выберите одну передачу для просмотра диагностики."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eylemler seçili aktarımlara uygulanır. Tanı bilgilerini incelemek için tek bir aktarım seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дії застосовуються до вибраних передавань. Виберіть одне передавання для перегляду діагностики."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作将应用于所选传输。选择单个传输以查看诊断信息。"
          }
        }
      }
    },
