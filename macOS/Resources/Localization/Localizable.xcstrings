    "Choose row density; right-click a column heading to choose columns": {
      "comment": "SeedHop macOS UI (LibraryView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeilendichte wählen; klicke mit der rechten Maustaste auf eine Spaltenüberschrift, um Spalten auszuwählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose row density; right-click a column heading to choose columns"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la densidad de filas; haz clic con el botón derecho en una cabecera para elegir columnas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la densité des lignes ; faites un clic droit sur un en-tête pour choisir les colonnes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la densità delle righe; fai clic destro sull’intestazione di una colonna per scegliere le colonne"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行の密度を選択。列見出しを右クリックして表示する列を選択"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행 밀도를 선택하세요. 열 제목을 오른쪽 클릭하여 열을 선택하세요"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
