          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite SeedHop en Ajustes del Sistema → General → Ítems de inicio y extensiones y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
