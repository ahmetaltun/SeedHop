          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorizza SeedHop in Impostazioni di Sistema → Generali → Elementi login ed estensioni, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」→「一般」→「ログイン項目と機能拡張」でSeedHopを許可してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 일반 → 로그인 항목 및 확장 프로그램에서 SeedHop을 허용한 다음 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na SeedHop w Ustawieniach systemowych → Ogólne → Rzeczy otwierane podczas logowania i rozszerzenia, a następnie spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o SeedHop em Ajustes do Sistema → Geral → Itens de Início e Extensões e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите SeedHop в «Системные настройки» → «Основные» → «Объекты входа и расширения», затем повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
