    "Overnight windows end the following day. Equal start and end times mean 24 hours. Windows cannot overlap.": {
      "comment": "SeedHop macOS UI (SchedulingSettingsView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitfenster über Nacht enden am Folgetag. Gleiche Start- und Endzeit bedeutet 24 Stunden. Zeitfenster dürfen sich nicht überschneiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overnight windows end the following day. Equal start and end times mean 24 hours. Windows cannot overlap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los intervalos nocturnos terminan al día siguiente. La misma hora de inicio y fin significa 24 horas. Los intervalos no pueden solaparse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plages nocturnes se terminent le lendemain. Des heures de début et de fin identiques signifient 24 heures. Les plages ne peuvent pas se chevaucher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fasce notturne terminano il giorno seguente. Orari di inizio e fine uguali indicano 24 ore. Le fasce non possono sovrapporsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日をまたぐ時間帯は翌日に終了します。開始と終了が同じ時刻なら24時間です。時間帯を重複させることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자정을 넘는 시간대는 다음 날 종료됩니다. 시작과 종료 시간이 같으면 24시간입니다. 시간대는 겹칠 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przedziały nocne kończą się następnego dnia. Taka sama godzina początku i końca oznacza 24 godziny. Przedziały nie mogą się nakładać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalos noturnos terminam no dia seguinte. Início e fim iguais significam 24 horas. Os intervalos não podem se sobrepor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ночные интервалы заканчиваются на следующий день. Одинаковое время начала и окончания означает 24 часа. Интервалы не должны пересекаться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geceyi aşan zaman aralıkları ertesi gün sona erer. Başlangıç ve bitiş saatlerinin aynı olması 24 saat demektir. Aralıklar çakışamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічні інтервали закінчуються наступного дня. Однаковий час початку й закінчення означає 24 години. Інтервали не мають перетинатися."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跨夜时间段在次日结束。开始和结束时间相同表示 24 小时。时间段不能重叠。"
          }
        }
      }
    },
