    "Accept encrypted peers. Try plaintext first when connecting, then encryption if needed.": {
      "comment": "SeedHop macOS UI (Models.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselte Peers akzeptieren. Beim Verbinden zuerst Klartext versuchen, dann bei Bedarf Verschlüsselung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept encrypted peers. Try plaintext first when connecting, then encryption if needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acepta pares cifrados. Al conectar, prueba primero sin cifrado y después con cifrado si es necesario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepte les pairs chiffrés. Essaie d’abord une connexion en clair, puis chiffrée si nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accetta peer crittografati. Alla connessione prova prima in chiaro, poi con crittografia se necessario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化ピアを受け入れます。接続時は平文を先に試し、必要に応じて暗号化を試します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화된 피어를 허용합니다. 연결 시 평문을 먼저 시도한 다음 필요하면 암호화를 시도합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Akceptuj szyfrowanych partnerów. Najpierw próbuj połączenia jawnego, a w razie potrzeby szyfrowanego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceitar pares criptografados. Ao conectar, tentar texto simples primeiro e criptografia depois, se necessário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принимать зашифрованные подключения пиров. При подключении сначала пробовать открытый текст, затем при необходимости шифрование."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifreli eşleri kabul et. Bağlanırken önce düz metni, gerekirse şifrelemeyi dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приймати зашифровані підключення пірів. Спочатку пробувати відкритий текст, а за потреби — шифрування."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接受加密节点。连接时先尝试明文，必要时再尝试加密。"
          }
        }
      }
    },
