    "Traffic history appears as live snapshots arrive.": {
      "comment": "SeedHop macOS UI (TorrentDiagnosticsView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verkehrsverlauf erscheint mit eintreffenden Live-Momentaufnahmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traffic history appears as live snapshots arrive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial de tráfico aparece a medida que llegan instantáneas en directo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique du trafic apparaît à mesure que les instantanés en direct arrivent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia del traffico appare con l’arrivo delle istantanee in tempo reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のスナップショットを受信すると通信履歴が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 스냅샷이 도착하면 트래픽 기록이 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia ruchu pojawia się wraz z bieżącymi odczytami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico de tráfego aparece conforme chegam instantâneos ao vivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История трафика появляется по мере получения текущих снимков."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı anlık görüntüler geldikçe trafik geçmişi görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історія трафіку з’являється в міру отримання поточних знімків."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时快照到达后将显示流量历史。"
          }
        }
      }
    },
