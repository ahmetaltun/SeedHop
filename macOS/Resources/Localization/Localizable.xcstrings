    "Check the destination disk and folder, then retry.": {
      "comment": "SeedHop macOS UI (EngineMessage.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe Ziellaufwerk und Zielordner und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the destination disk and folder, then retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba el disco y la carpeta de destino y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le disque et le dossier de destination, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il disco e la cartella di destinazione, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存先のディスクとフォルダを確認してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 디스크와 폴더를 확인한 다음 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź dysk i folder docelowy, a następnie spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique o disco e a pasta de destino e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте целевой диск и папку, затем повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
