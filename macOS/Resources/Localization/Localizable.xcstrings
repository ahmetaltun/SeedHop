    "A listening port does not confirm incoming reachability. Routers, firewalls, and the network can block connections.": {
      "comment": "SeedHop macOS UI (SettingsView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein offener Port bestätigt keine Erreichbarkeit von außen. Router, Firewalls und das Netzwerk können Verbindungen blockieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A listening port does not confirm incoming reachability. Routers, firewalls, and the network can block connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un puerto de escucha no confirma la accesibilidad entrante. Los routers, cortafuegos y la red pueden bloquear conexiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un port d’écoute ne garantit pas l’accès entrant. Les routeurs, les pare-feu et le réseau peuvent bloquer les connexions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una porta in ascolto non conferma la raggiungibilità dall’esterno. Router, firewall e rete possono bloccare le connessioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待ち受けポートがあっても、外部から接続できるとは限りません。ルーター、ファイアウォール、ネットワークが接続を遮断する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수신 대기 포트가 있어도 외부 연결이 가능하다는 뜻은 아닙니다. 라우터, 방화벽 또는 네트워크가 연결을 차단할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Port nasłuchujący nie gwarantuje dostępności połączeń przychodzących. Mogą je blokować routery, zapory i sieć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma porta de escuta não confirma a acessibilidade de conexões de entrada. Roteadores, firewalls e a rede podem bloquear conexões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наличие порта прослушивания не гарантирует доступность входящих подключений. Их могут блокировать маршрутизатор, брандмауэр или сеть."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinleme bağlantı noktası, gelen bağlantıların ulaşabildiğini doğrulamaz. Yönlendiriciler, güvenlik duvarları ve ağ bağlantıları engelleyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наявність порту прослуховування не гарантує доступності вхідних підключень. Їх можуть блокувати маршрутизатор, брандмауер або мережа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存在监听端口并不代表外部可以连接。路由器、防火墙和网络都可能阻止连接。"
          }
        }
      }
    },
