    "The engine stopped this transfer. %@ See details if the error returns.": {
      "comment": "SeedHop macOS UI (TransferPresentation.swift). Preserve placeholder types and positions; use positional placeholders when reordering. Text arguments may be verbatim user names, paths, or formatted quantities.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Engine hat diese Übertragung gestoppt. %@ Sieh dir die Details an, falls der Fehler erneut auftritt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine stopped this transfer. %@ See details if the error returns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor detuvo esta transferencia. %@ Consulta los detalles si el error vuelve a ocurrir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
