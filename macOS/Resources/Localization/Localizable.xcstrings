    "The original location is still active. Extra copies were retained. Retry cleanup after restoring access, or inspect the folders and keep the extra copies.": {
      "comment": "SeedHop macOS UI (EngineMessage.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ursprüngliche Speicherort ist weiterhin aktiv. Zusätzliche Kopien wurden beibehalten. Stelle den Zugriff wieder her und versuche die Bereinigung erneut oder prüfe die Ordner und behalte die zusätzlichen Kopien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original location is still active. Extra copies were retained. Retry cleanup after restoring access, or inspect the folders and keep the extra copies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación original sigue activa. Se conservaron copias adicionales. Restaura el acceso y reintenta la limpieza, o revisa las carpetas y conserva las copias adicionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’emplacement d’origine est toujours actif. Des copies supplémentaires ont été conservées. Rétablissez l’accès et réessayez le nettoyage, ou examinez les dossiers et conservez les copies supplémentaires."
          }
