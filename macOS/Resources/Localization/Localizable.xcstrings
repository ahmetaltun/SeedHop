    "Allow SeedHop in System Settings → General → Login Items & Extensions, then try again.": {
      "comment": "SeedHop macOS UI (LibraryStore.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube SeedHop unter Systemeinstellungen → Allgemein → Anmeldeobjekte & Erweiterungen und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
