    "Rates use observed payload-counter changes. Encryption describes peer payloads and does not hide your IP address.": {
      "comment": "SeedHop macOS UI (TorrentDiagnosticsView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Raten basieren auf beobachteten Änderungen der Nutzdatenzähler. Verschlüsselung betrifft Peer-Nutzdaten und verbirgt deine IP-Adresse nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rates use observed payload-counter changes. Encryption describes peer payloads and does not hide your IP address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las velocidades usan cambios observados en los contadores de datos útiles. El cifrado describe los datos de los pares y no oculta tu dirección IP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les débits utilisent les variations observées des compteurs de données utiles. Le chiffrement concerne les données des pairs et ne masque pas votre adresse IP."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le velocità usano le variazioni osservate nei contatori dei dati utili. La crittografia riguarda i dati dei peer e non nasconde il tuo indirizzo IP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "速度は観測したペイロードカウンターの変化に基づきます。暗号化はピアのペイロードについての情報で、IPアドレスは隠しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "속도는 관측된 페이로드 카운터의 변화를 기준으로 합니다. 암호화는 피어 페이로드를 설명하며 IP 주소를 숨기지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prędkości wynikają ze zmian liczników danych użytkowych. Szyfrowanie dotyczy danych partnerów i nie ukrywa adresu IP."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As taxas usam as alterações observadas dos contadores de payload. A criptografia descreve os payloads dos pares e não oculta seu endereço IP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скорость рассчитана по изменениям счётчиков полезных данных. Шифрование относится к данным пиров и не скрывает IP-адрес."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlar, gözlemlenen veri sayacı değişikliklerini kullanır. Şifreleme eş verilerini açıklar ve IP adresinizi gizlemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Швидкість розраховано за змінами лічильників корисних даних. Шифрування стосується даних пірів і не приховує IP-адресу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "速率基于观测到的有效载荷计数器变化。加密描述的是节点有效载荷，不会隐藏你的 IP 地址。"
          }
        }
      }
    },
