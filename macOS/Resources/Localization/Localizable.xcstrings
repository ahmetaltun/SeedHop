    "Background access is unavailable. Transfers will run while SeedHop is open. You can enable background access in Settings.": {
      "comment": "SeedHop macOS UI (LibraryStore.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrundzugriff ist nicht verfügbar. Übertragungen laufen, solange SeedHop geöffnet ist. Du kannst den Hintergrundzugriff in den Einstellungen aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background access is unavailable. Transfers will run while SeedHop is open. You can enable background access in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso en segundo plano no está disponible. Las transferencias continuarán mientras SeedHop esté abierto. Puedes activar el acceso en segundo plano en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès en arrière-plan est indisponible. Les transferts continuent tant que SeedHop est ouvert. Vous pouvez activer l’accès en arrière-plan dans les réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso in background non è disponibile. I trasferimenti continueranno mentre SeedHop è aperto. Puoi abilitare l’accesso in background nelle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンド動作を利用できません。SeedHopを開いている間は転送できます。設定でバックグラウンド動作を有効にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 접근을 사용할 수 없습니다. SeedHop이 열려 있는 동안 전송이 실행됩니다. 설정에서 백그라운드 접근을 활성화할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp w tle jest niedostępny. Transfery działają, gdy SeedHop jest otwarty. Dostęp w tle można włączyć w ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso em segundo plano está indisponível. As transferências funcionarão enquanto o SeedHop estiver aberto. Você pode ativar o acesso em segundo plano nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоновый доступ недоступен. Передачи работают, пока SeedHop открыт. Разрешить фоновый доступ можно в настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka plan erişimi kullanılamıyor. Aktarımlar SeedHop açıkken çalışır. Arka plan erişimini Ayarlar’dan etkinleştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоновий доступ недоступний. Передавання працюють, доки SeedHop відкрито. Дозволити фоновий доступ можна в параметрах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台访问不可用。SeedHop 打开期间传输将继续运行。你可以在设置中启用后台访问。"
          }
        }
      }
    },
