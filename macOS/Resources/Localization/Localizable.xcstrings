    "Wait for the current file change to finish, or cancel it, then add your torrent.": {
      "comment": "SeedHop macOS UI (LibraryStore.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte, bis die aktuelle Dateiänderung abgeschlossen ist, oder brich sie ab. Füge dann deinen Torrent hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the current file change to finish, or cancel it, then add your torrent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que termine el cambio de archivos actual o cancélalo y después añade tu torrent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez la fin de la modification de fichiers actuelle ou annulez-la, puis ajoutez votre torrent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendi il completamento della modifica ai file attuale oppure annullala, poi aggiungi il torrent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のファイル変更が完了するまで待つかキャンセルしてから、トレントを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 파일 변경이 완료될 때까지 기다리거나 취소한 다음 토렌트를 추가하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczekaj na zakończenie bieżącej zmiany plików lub ją anuluj, a następnie dodaj torrent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde a alteração atual dos arquivos terminar ou cancele-a e depois adicione seu torrent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дождитесь завершения текущего изменения файлов или отмените его, затем добавьте торрент."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli dosya değişikliğinin tamamlanmasını bekleyin veya iptal edin, ardından torrentinizi ekleyin."
