    "The active location could not be established. All copies were retained. Inspect the folders before changing files.": {
      "comment": "SeedHop macOS UI (EngineMessage.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktive Speicherort konnte nicht ermittelt werden. Alle Kopien wurden beibehalten. Prüfe die Ordner, bevor du Dateien änderst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The active location could not be established. All copies were retained. Inspect the folders before changing files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo determinar la ubicación activa. Se conservaron todas las copias. Revisa las carpetas antes de modificar archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de déterminer l’emplacement actif. Toutes les copies ont été conservées. Examinez les dossiers avant de modifier des fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile determinare la posizione attiva. Tutte le copie sono state conservate. Controlla le cartelle prima di modificare i file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中の場所を確認できませんでした。すべてのコピーを保持しました。ファイルを変更する前にフォルダを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 위치를 확인할 수 없습니다. 모든 사본이 보관되었습니다. 파일을 변경하기 전에 폴더를 확인하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można ustalić aktywnego położenia. Wszystkie kopie zachowano. Sprawdź foldery przed zmianą plików."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível determinar o local ativo. Todas as cópias foram mantidas. Inspecione as pastas antes de alterar os arquivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось определить активное расположение. Все копии сохранены. Проверьте папки перед изменением файлов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin konum belirlenemedi. Tüm kopyalar korundu. Dosyaları değiştirmeden önce klasörleri inceleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося визначити активне розташування. Усі копії збережено. Перевірте папки перед зміною файлів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确定活动位置。所有副本均已保留。更改文件前请检查文件夹。"
          }
        }
      }
    },
    "The engine could not complete this action. Check the details, then try again.": {
      "comment": "SeedHop macOS UI (EngineMessage.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Engine konnte diese Aktion nicht abschließen. Prüfe die Details und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine could not complete this action. Check the details, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor no pudo completar esta acción. Consulta los detalles y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur n’a pas pu terminer cette action. Consultez les détails et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore non ha potuto completare questa azione. Controlla i dettagli e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンはこの操作を完了できませんでした。詳細を確認してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엔진이 이 작업을 완료하지 못했습니다. 세부사항을 확인한 다음 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Silnik nie może ukończyć tego działania. Sprawdź szczegóły i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mecanismo não conseguiu concluir esta ação. Verifique os detalhes e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Движку не удалось выполнить это действие. Просмотрите подробности и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motor bu eylemi tamamlayamadı. Ayrıntıları denetleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рушію не вдалося виконати цю дію. Перегляньте подробиці й повторіть спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎无法完成此操作。请查看详情，然后重试。"
          }
        }
      }
    },
    "The engine could not restart. Your library has been preserved.": {
      "comment": "SeedHop macOS UI (LibraryStore.swift).",
      "localizations": {
        "de": {
