    "Resume paused transfers or retry errors without changing saved pause intent": {
      "comment": "SeedHop macOS UI (LibraryView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausierte Übertragungen fortsetzen oder Fehler erneut versuchen, ohne die gespeicherte Pausenabsicht zu ändern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume paused transfers or retry errors without changing saved pause intent"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanudar transferencias en pausa o reintentar errores sin cambiar la intención de pausa guardada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprendre les transferts en pause ou réessayer après une erreur sans modifier l’intention de pause enregistrée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprendi i trasferimenti in pausa o riprova dopo un errore senza modificare la scelta di pausa salvata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した一時停止設定を変えずに、一時停止中の転送を再開、またはエラーを再試行"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 일시 정지 의도를 변경하지 않고 일시 정지된 전송을 재개하거나 오류 재시도"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wznów wstrzymane transfery lub ponów po błędach bez zmiany zapisanego ustawienia wstrzymania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retomar transferências pausadas ou repetir erros sem alterar a intenção de pausa salva"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возобновить приостановленные передачи или повторить попытку после ошибок, не меняя сохранённый выбор паузы"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı duraklatma tercihini değiştirmeden duraklatılmış aktarımları sürdür veya hataları yeniden dene"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновити призупинені передавання або повторити спробу після помилок, не змінюючи збережений вибір паузи"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续已暂停的传输或重试错误，不改变已保存的暂停意图"
          }
        }
      }
    },
