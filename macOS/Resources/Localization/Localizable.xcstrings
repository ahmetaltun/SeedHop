    "Copy diagnostics with tracker credentials, peer endpoints, and personal paths removed": {
      "comment": "SeedHop macOS UI (TorrentDiagnosticsView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnose ohne Tracker-Zugangsdaten, Peer-Endpunkte und persönliche Pfade kopieren"
