          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 대기열의 %u번째입니다. 활성 다운로드 자리가 나기를 기다립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
