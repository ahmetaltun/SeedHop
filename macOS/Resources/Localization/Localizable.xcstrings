    "%@ Click to edit bandwidth limits.": {
      "comment": "SeedHop macOS UI (LibraryView.swift). Preserve placeholder types and positions; use positional placeholders when reordering. Text arguments may be verbatim user names, paths, or formatted quantities.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Zum Bearbeiten der Bandbreitenlimits klicken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Click to edit bandwidth limits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Haz clic para editar los límites de ancho de banda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Cliquez pour modifier les limites de bande passante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Fai clic per modificare i limiti di banda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ クリックして帯域制限を編集します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 클릭하여 대역폭 제한을 편집하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Kliknij, aby zmienić limity przepustowości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Clique para editar os limites de largura de banda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Нажмите, чтобы изменить ограничения скорости."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Bant genişliği sınırlarını düzenlemek için tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Натисніть, щоб змінити обмеження швидкості."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 点击编辑带宽限制。"
          }
        }
      }
    },
