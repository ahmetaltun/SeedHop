    "Use plaintext peer connections only. Encrypted-only peers cannot connect.": {
      "comment": "SeedHop macOS UI (Models.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur unverschlüsselte Peer-Verbindungen verwenden. Peers, die ausschließlich Verschlüsselung unterstützen, können sich nicht verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use plaintext peer connections only. Encrypted-only peers cannot connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa solo conexiones de pares sin cifrar. Los pares que solo admiten cifrado no pueden conectarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise uniquement des connexions aux pairs en clair. Les pairs exigeant le chiffrement ne peuvent pas se connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa solo connessioni ai peer in chiaro. I peer che richiedono la crittografia non possono connettersi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平文のピア接続のみ使用します。暗号化専用のピアには接続できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평문 피어 연결만 사용합니다. 암호화만 지원하는 피어는 연결할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używaj tylko jawnych połączeń z partnerami. Partnerzy wymagający szyfrowania nie będą mogli się połączyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar apenas conexões de pares em texto simples. Pares que exigem criptografia não poderão se conectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать только незашифрованные подключения пиров. Пиры, требующие шифрование, не смогут подключиться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca düz metin eş bağlantılarını kullan. Yalnızca şifreli bağlantıları destekleyen eşler bağlanamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовувати лише незашифровані підключення пірів. Піри, що вимагають шифрування, не зможуть підключитися."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅使用明文节点连接。仅支持加密的节点无法连接。"
          }
        }
      }
    },
    "Verified content and network traffic are separate measurements. Historical values are unavailable for transfers added before statistics were recorded.": {
      "comment": "SeedHop macOS UI (TorrentDiagnosticsView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geprüfte Inhalte und Netzwerkverkehr sind getrennte Messwerte. Historische Werte fehlen für Übertragungen, die vor Beginn der Statistikaufzeichnung hinzugefügt wurden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified content and network traffic are separate measurements. Historical values are unavailable for transfers added before statistics were recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido verificado y el tráfico de red son mediciones distintas. Los valores históricos no están disponibles para transferencias añadidas antes de registrar estadísticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu vérifié et le trafic réseau sont des mesures distinctes. Les valeurs historiques sont indisponibles pour les transferts ajoutés avant l’enregistrement des statistiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto verificato e il traffico di rete sono misurazioni distinte. I valori storici non sono disponibili per i trasferimenti aggiunti prima della registrazione delle statistiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証済みの内容とネットワーク通信量は別の測定値です。統計の記録開始前に追加した転送には履歴値がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검사된 콘텐츠와 네트워크 트래픽은 별도의 측정값입니다. 통계 기록 이전에 추가된 전송은 과거 값을 사용할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzona zawartość i ruch sieciowy są osobnymi pomiarami. Wartości historyczne są niedostępne dla transferów dodanych przed rozpoczęciem zapisywania statystyk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteúdo verificado e tráfego de rede são medições separadas. Valores históricos não estão disponíveis para transferências adicionadas antes do registro de estatísticas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверенное содержимое и сетевой трафик измеряются отдельно. Исторические значения недоступны для передач, добавленных до начала записи статистики."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulanan içerik ve ağ trafiği farklı ölçümlerdir. İstatistik kaydı başlamadan önce eklenen aktarımlar için geçmiş değerler kullanılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірений вміст і мережевий трафік вимірюються окремо. Історичні значення недоступні для передавань, доданих до початку запису статистики."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已校验内容和网络流量是不同的度量。开始记录统计信息之前添加的传输没有历史值。"
          }
        }
      }
    },
