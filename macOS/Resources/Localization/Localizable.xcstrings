    "“%@” will be removed. Its files stay on your Mac unless you choose to delete them.": {
      "comment": "SeedHop macOS UI (LibraryView.swift). Preserve placeholder types and positions; use positional placeholders when reordering. Text arguments may be verbatim user names, paths, or formatted quantities.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wird entfernt. Die Dateien bleiben auf deinem Mac, sofern du sie nicht löschen lässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will be removed. Its files stay on your Mac unless you choose to delete them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará «%@». Sus archivos permanecerán en tu Mac salvo que elijas borrarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » sera supprimé. Ses fichiers resteront sur votre Mac sauf si vous choisissez de les effacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” verrà rimosso. I file resteranno sul Mac a meno che tu non scelga di eliminarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を削除します。ファイルの削除を選ばない限り、ファイルはMacに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 항목이 제거됩니다. 파일 삭제를 선택하지 않는 한 파일은 Mac에 남습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” zostanie usunięte. Pliki pozostaną na Macu, chyba że wybierzesz ich usunięcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” será removido. Os arquivos ficam no seu Mac, a menos que você escolha apagá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» будет удалено. Файлы останутся на Mac, если вы не решите их стереть."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” kaldırılacak. Silmeyi seçmediğiniz sürece dosyaları Mac’inizde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» буде вилучено. Файли залишаться на Mac, якщо ви не вирішите їх видалити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将移除“%@”。除非你选择删除文件，否则文件会保留在 Mac 上。"
          }
        }
      }
    },
