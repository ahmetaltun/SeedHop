          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル一覧を読み取れませんでした。別のトレントファイルかマグネットリンクをお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 목록을 읽을 수 없습니다. 다른 토렌트 파일이나 마그넷 링크를 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać listy plików. Wypróbuj inny plik torrent lub link magnet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a lista de arquivos. Tente outro arquivo torrent ou link magnet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать список файлов. Попробуйте другой торрент-файл или magnet-ссылку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya listesi okunamadı. Başka bir torrent dosyası veya magnet bağlantısı deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати список файлів. Спробуйте інший торрент-файл або magnet-посилання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取文件列表。请尝试其他种子文件或磁力链接。"
          }
        }
      }
    },
    "The new location is saved. Extra copies were retained. Retry cleanup after restoring access, or inspect the folders and keep the extra copies.": {
      "comment": "SeedHop macOS UI (EngineMessage.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der neue Speicherort ist gespeichert. Zusätzliche Kopien wurden beibehalten. Stelle den Zugriff wieder her und versuche die Bereinigung erneut oder prüfe die Ordner und behalte die zusätzlichen Kopien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new location is saved. Extra copies were retained. Retry cleanup after restoring access, or inspect the folders and keep the extra copies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nueva ubicación está guardada. Se conservaron copias adicionales. Restaura el acceso y reintenta la limpieza, o revisa las carpetas y conserva las copias adicionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouvel emplacement est enregistré. Des copies supplémentaires ont été conservées. Rétablissez l’accès et réessayez le nettoyage, ou examinez les dossiers et conservez les copies supplémentaires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nuova posizione è salvata. Sono state conservate copie aggiuntive. Ripristina l’accesso e riprova la pulizia, oppure controlla le cartelle e conserva le copie aggiuntive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい場所を保存しました。余分なコピーは保持されています。アクセスを復元してクリーンアップを再試行するか、フォルダを確認して余分なコピーを保持してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 위치가 저장되었습니다. 추가 사본이 보관되었습니다. 접근 권한을 복원한 후 정리를 다시 시도하거나 폴더를 확인하고 추가 사본을 유지하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano nowe położenie. Dodatkowe kopie zachowano. Po przywróceniu dostępu ponów czyszczenie lub sprawdź foldery i zachowaj dodatkowe kopie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O novo local foi salvo. Cópias extras foram mantidas. Restaure o acesso e repita a limpeza ou inspecione as pastas e mantenha as cópias extras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новое расположение сохранено. Дополнительные копии сохранены. Восстановите доступ и повторите очистку либо проверьте папки и оставьте дополнительные копии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni konum kaydedildi. Ek kopyalar korundu. Erişimi geri yükledikten sonra temizliği yeniden deneyin veya klasörleri inceleyip ek kopyaları koruyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нове розташування збережено. Додаткові копії збережено. Відновіть доступ і повторіть очищення або перевірте папки й залиште додаткові копії."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新位置已保存。额外副本已保留。请恢复访问权限后重试清理，或检查文件夹并保留额外副本。"
          }
        }
      }
    },
    "The operation was cancelled.": {
