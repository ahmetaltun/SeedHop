    "Restart SeedHop to finish updating its engine.": {
      "comment": "SeedHop macOS UI (EngineClient.swift, EngineMessage.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte SeedHop neu, um die Aktualisierung der Engine abzuschließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart SeedHop to finish updating its engine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia SeedHop para terminar de actualizar su motor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redémarrez SeedHop pour terminer la mise à jour de son moteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riavvia SeedHop per completare l’aggiornamento del motore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンの更新を完了するにはSeedHopを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엔진 업데이트를 완료하려면 SeedHop을 재시작하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom ponownie SeedHop, aby dokończyć aktualizację silnika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicie o SeedHop para concluir a atualização do mecanismo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапустите SeedHop, чтобы завершить обновление движка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motor güncellemesini tamamlamak için SeedHop’u yeniden başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапустіть SeedHop, щоб завершити оновлення рушія."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重启 SeedHop 以完成引擎更新。"
          }
        }
      }
    },
