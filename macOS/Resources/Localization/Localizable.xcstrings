    "Completed transfers keep seeding. Paused transfers stay paused.": {
      "comment": "SeedHop macOS UI (SettingsView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeschlossene Übertragungen werden weiter geteilt. Pausierte Übertragungen bleiben pausiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed transfers keep seeding. Paused transfers stay paused."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transferencias completadas siguen compartiéndose. Las transferencias en pausa permanecen en pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les transferts terminés continuent d’être partagés. Les transferts en pause le restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I trasferimenti completati continuano a essere condivisi. Quelli in pausa restano in pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了した転送はシードを続けます。一時停止した転送はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료된 전송은 시드를 계속합니다. 일시 정지된 전송은 그대로 유지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukończone transfery nadal są udostępniane. Wstrzymane transfery pozostają wstrzymane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferências concluídas continuam semeando. Transferências pausadas continuam pausadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершённые передачи продолжают раздаваться. Приостановленные передачи остаются на паузе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlanan aktarımlar paylaşılmaya devam eder. Duraklatılan aktarımlar duraklatılmış kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершені передавання продовжують роздаватися. Призупинені передавання залишаються на паузі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成的传输会继续做种。已暂停的传输保持暂停。"
          }
        }
      }
    },
    "Connect to the engine to change limits. Displayed limits are the last known values.": {
      "comment": "SeedHop macOS UI (BandwidthSettingsView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dich mit der Engine, um Limits zu ändern. Angezeigt werden die zuletzt bekannten Limits."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the engine to change limits. Displayed limits are the last known values."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta con el motor para cambiar los límites. Se muestran los últimos valores conocidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous au moteur pour modifier les limites. Les valeurs affichées sont les dernières connues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collegati al motore per modificare i limiti. Sono mostrati gli ultimi valori noti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限を変更するにはエンジンに接続してください。表示されている制限は最後に確認した値です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한을 변경하려면 엔진에 연결하세요. 표시된 제한은 마지막으로 확인된 값입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się z silnikiem, aby zmienić limity. Wyświetlane limity to ostatnie znane wartości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se ao mecanismo para alterar os limites. Os limites exibidos são os últimos valores conhecidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь к движку, чтобы изменить ограничения. Показаны последние известные значения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırları değiştirmek için motora bağlanın. Gösterilen sınırlar bilinen son değerlerdir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіться до рушія, щоб змінити обмеження. Показано останні відомі значення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接引擎后才能更改限制。显示的限制是上次已知的值。"
          }
        }
      }
    },
