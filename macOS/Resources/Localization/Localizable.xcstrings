    "0 means unlimited. These caps replace normal limits during this window.": {
      "comment": "SeedHop macOS UI (SchedulingSettingsView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0 bedeutet unbegrenzt. Diese Limits ersetzen während dieses Zeitfensters die normalen Limits."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0 means unlimited. These caps replace normal limits during this window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "0 significa sin límite. Estos límites sustituyen los normales durante este intervalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "0 signifie illimité. Ces limites remplacent les limites normales pendant cette plage horaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "0 significa illimitato. Questi limiti sostituiscono quelli normali durante questa fascia oraria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0は無制限です。この時間帯は通常の制限の代わりにこれらを適用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0은 무제한입니다. 이 시간대에는 일반 제한 대신 이 제한이 적용됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "0 oznacza brak limitu. W tym przedziale te limity zastępują zwykłe limity."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "0 significa sem limite. Estes limites substituem os limites normais durante este intervalo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "0 означает отсутствие ограничения. В этом интервале эти ограничения заменяют обычные."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "0 sınırsız demektir. Bu sınırlar, bu zaman aralığında normal sınırların yerini alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "0 означає відсутність обмеження. У цьому інтервалі ці обмеження замінюють звичайні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0 表示不限速。在此时间段内，这些限制将替代常规限制。"
          }
        }
      }
    },
