    "Preparing the transfer without changing your saved pause setting.": {
      "comment": "SeedHop macOS UI (TransferPresentation.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übertragung wird vorbereitet, ohne deine gespeicherte Pauseneinstellung zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing the transfer without changing your saved pause setting."
          }
        },
