    "Suspended by the weekly schedule. Manual pause choices are preserved. Change scheduling in Transfers settings.": {
      "comment": "SeedHop macOS UI (TransferPresentation.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch den wöchentlichen Zeitplan ausgesetzt. Manuelle Pausenentscheidungen bleiben erhalten. Ändere die Zeitplanung in den Übertragungseinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspended by the weekly schedule. Manual pause choices are preserved. Change scheduling in Transfers settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendido por la programación semanal. Se conservan las pausas manuales. Cambia la programación en los ajustes de transferencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendu par la planification hebdomadaire. Les pauses manuelles sont conservées. Modifiez la planification dans les réglages des transferts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sospeso dalla pianificazione settimanale. Le scelte di pausa manuali vengono conservate. Modifica la pianificazione nelle impostazioni dei trasferimenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週間スケジュールにより停止中です。手動の一時停止設定は保持されています。「転送」設定でスケジュールを変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주간 예약에 의해 중단되었습니다. 수동 일시 정지 선택은 유지됩니다. 전송 설정에서 예약을 변경하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymano przez harmonogram tygodniowy. Ręczne ustawienia wstrzymania są zachowane. Zmień harmonogram w ustawieniach transferów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspenso pela programação semanal. Suas pausas manuais foram preservadas. Altere a programação nos ajustes de transferências."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостановлено недельным расписанием. Ручные настройки паузы сохранены. Измените расписание в настройках передач."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftalık zamanlama tarafından askıya alındı. Elle duraklatma tercihleri korunur. Zamanlamayı Aktarımlar ayarlarından değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призупинено тижневим розкладом. Ручні параметри паузи збережено. Змініть розклад у параметрах передавань."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已由每周计划暂停。手动暂停设置已保留。可在“传输”设置中更改计划。"
          }
        }
      }
    },
    "Suspension preserves manual pause choices, file selections and queue order. Verification and file moves can finish.": {
      "comment": "SeedHop macOS UI (SchedulingSettingsView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Aussetzen bewahrt manuelle Pausenentscheidungen, Dateiauswahl und Warteschlangenreihenfolge. Prüfungen und Dateiverschiebungen können abgeschlossen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspension preserves manual pause choices, file selections and queue order. Verification and file moves can finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suspensión conserva las pausas manuales, la selección de archivos y el orden de la cola. Las comprobaciones y movimientos de archivos pueden terminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suspension conserve les pauses manuelles, les sélections de fichiers et l’ordre de la file. Les vérifications et déplacements de fichiers peuvent se terminer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sospensione conserva le scelte di pausa manuali, le selezioni dei file e l’ordine della coda. Le verifiche e gli spostamenti dei file possono terminare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止中も手動の一時停止、ファイル選択、キュー順序は保持されます。検証やファイルの移動は完了できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중단해도 수동 일시 정지, 파일 선택 및 대기열 순서는 유지됩니다. 검사와 파일 이동은 완료될 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymanie zachowuje ręczne ustawienia pauzy, wybór plików i kolejność kolejki. Sprawdzanie i przenoszenie plików mogą się zakończyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A suspensão preserva pausas manuais, seleção de arquivos e ordem da fila. Verificações e movimentações de arquivos podem terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостановка сохраняет ручные настройки паузы, выбор файлов и порядок очереди. Проверка и перемещение файлов могут завершиться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Askıya alma; elle duraklatma tercihlerini, dosya seçimlerini ve sıra düzenini korur. Doğrulama ve dosya taşıma tamamlanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призупинення зберігає ручні параметри паузи, вибір файлів і порядок черги. Перевірка й переміщення файлів можуть завершитися."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停会保留手动暂停选择、文件选择和队列顺序。校验和文件移动可继续完成。"
          }
        }
      }
    },
