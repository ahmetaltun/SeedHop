    "No peer connections are reported. This does not establish a tracker or network failure.": {
      "comment": "SeedHop macOS UI (TorrentDiagnosticsView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden keine Peer-Verbindungen gemeldet. Dies belegt keinen Tracker- oder Netzwerkfehler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No peer connections are reported. This does not establish a tracker or network failure."
          }
        },
        "es": {
