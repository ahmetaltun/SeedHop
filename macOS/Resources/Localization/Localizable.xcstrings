    "Use arrow keys to choose rows. Space toggles whether those files will download.": {
      "comment": "SeedHop macOS UI (ImportView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Zeilen mit den Pfeiltasten. Mit der Leertaste legst du fest, ob diese Dateien heruntergeladen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use arrow keys to choose rows. Space toggles whether those files will download."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa las flechas para elegir filas. La barra espaciadora alterna si se descargarán esos archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les flèches pour choisir les lignes. La barre d’espace active ou désactive le téléchargement de ces fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa i tasti freccia per scegliere le righe. La barra spaziatrice attiva o disattiva il download di quei file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "矢印キーで行を選択します。スペースキーでファイルをダウンロードするかどうかを切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화살표 키로 행을 선택하세요. 스페이스 키로 해당 파일의 다운로드 여부를 전환합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używaj strzałek, aby wybierać wiersze. Spacja przełącza pobieranie tych plików."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use as setas para escolher linhas. A barra de espaço alterna se esses arquivos serão baixados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирайте строки клавишами со стрелками. Пробел включает или отключает загрузку этих файлов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satır seçmek için ok tuşlarını kullanın. Boşluk tuşu bu dosyaların indirilip indirilmeyeceğini değiştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибирайте рядки клавішами зі стрілками. Пробіл вмикає або вимикає завантаження цих файлів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用方向键选择行。空格键可切换是否下载这些文件。"
          }
        }
      }
    },
    "Use at most %llu schedule windows.": {
      "comment": "SeedHop macOS UI (EngineMessage.swift).",
