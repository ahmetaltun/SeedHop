    "SeedHop could not complete this action. Check the details, then try again.": {
      "comment": "SeedHop macOS UI (EngineMessage.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop konnte diese Aktion nicht abschließen. Prüfe die Details und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop could not complete this action. Check the details, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop no pudo completar esta acción. Consulta los detalles y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop n’a pas pu terminer cette action. Consultez les détails et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop non ha potuto completare questa azione. Controlla i dettagli e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHopはこの操作を完了できませんでした。詳細を確認してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop이 이 작업을 완료하지 못했습니다. 세부사항을 확인한 다음 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop nie może ukończyć tego działania. Sprawdź szczegóły i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SeedHop não conseguiu concluir esta ação. Verifique os detalhes e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop не удалось выполнить это действие. Просмотрите подробности и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop bu eylemi tamamlayamadı. Ayrıntıları denetleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop не вдалося виконати цю дію. Перегляньте подробиці й повторіть спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop 无法完成此操作。请查看详情，然后重试。"
          }
        }
      }
    },
    "SeedHop rechecks saved files after an engine restart.": {
