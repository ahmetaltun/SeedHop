    "Position %u in the download queue. Waiting for an active download slot.": {
      "comment": "SeedHop macOS UI (TransferPresentation.swift). Preserve placeholder types and positions; use positional placeholders when reordering. Text arguments may be verbatim user names, paths, or formatted quantities.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Position %u in der Downloadwarteschlange. Warten auf einen freien Downloadplatz."
          }
        },
        "en": {
