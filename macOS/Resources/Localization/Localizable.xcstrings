          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferências já pausadas continuarão pausadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ранее приостановленные передачи останутся на паузе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
