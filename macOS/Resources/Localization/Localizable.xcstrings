            "state": "translated",
            "value": "Suspend downloads and seeding"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspender descargas y compartición"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendre les téléchargements et le partage"
          }
        },
        "it": {
