    "Transfer changes, tracker failures, recovery, and file operations appear here.": {
      "comment": "SeedHop macOS UI (TorrentDiagnosticsView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übertragungsänderungen, Tracker-Fehler, Wiederherstellung und Dateivorgänge erscheinen hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer changes, tracker failures, recovery, and file operations appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecen los cambios de transferencias, fallos de trackers, recuperación y operaciones de archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications de transfert, les défaillances des trackers, la récupération et les opérations sur les fichiers apparaissent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui appaiono modifiche ai trasferimenti, errori dei tracker, ripristino e operazioni sui file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転送の変更、トラッカーの失敗、復旧、ファイル操作がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송 변경, 트래커 오류, 복구 및 파일 작업이 여기에 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj pojawiają się zmiany transferów, błędy trackerów, odzyskiwanie i operacje na plikach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterações de transferência, falhas de rastreador, recuperação e operações de arquivos aparecem aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь отображаются изменения передач, сбои трекеров, восстановление и файловые операции."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktarım değişiklikleri, izleyici hataları, kurtarma ve dosya işlemleri burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут відображаються зміни передавань, збої трекерів, відновлення й файлові операції."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传输更改、Tracker 故障、恢复和文件操作会显示在此处。"
          }
        }
      }
    },
