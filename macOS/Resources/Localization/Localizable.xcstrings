          }
        }
      }
    },
    "The file list could not be read. Try another torrent file or magnet link.": {
      "comment": "SeedHop macOS UI (ImportSession.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateiliste konnte nicht gelesen werden. Versuche eine andere Torrent-Datei oder einen anderen Magnet-Link."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file list could not be read. Try another torrent file or magnet link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la lista de archivos. Prueba otro archivo torrent o enlace magnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la liste des fichiers. Essayez un autre fichier torrent ou lien magnet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
