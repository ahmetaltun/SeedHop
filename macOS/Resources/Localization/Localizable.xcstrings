    "Previously paused transfers will stay paused.": {
      "comment": "SeedHop macOS UI (SettingsView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuvor pausierte Übertragungen bleiben pausiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previously paused transfers will stay paused."
          }
        },
        "es": {
