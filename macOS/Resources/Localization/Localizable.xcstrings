    "Transfer statistics could not be saved. Check space and access to the library folder. Totals remain in memory until saving succeeds.": {
      "comment": "SeedHop macOS UI (EngineMessage.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übertragungsstatistiken konnten nicht gespeichert werden. Prüfe Speicherplatz und Zugriff auf den Mediatheksordner. Die Summen bleiben im Arbeitsspeicher, bis das Speichern gelingt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer statistics could not be saved. Check space and access to the library folder. Totals remain in memory until saving succeeds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar las estadísticas de transferencia. Comprueba el espacio y el acceso a la carpeta de la biblioteca. Los totales permanecen en memoria hasta que se guarden correctamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer les statistiques de transfert. Vérifiez l’espace et l’accès au dossier de la bibliothèque. Les totaux restent en mémoire jusqu’à la réussite de l’enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare le statistiche di trasferimento. Controlla lo spazio e l’accesso alla cartella della libreria. I totali restano in memoria fino al salvataggio riuscito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転送の統計情報を保存できませんでした。ライブラリフォルダの空き容量とアクセス権を確認してください。保存できるまで合計値はメモリに保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송 통계를 저장할 수 없습니다. 라이브러리 폴더의 공간과 접근 권한을 확인하세요. 저장에 성공할 때까지 합계는 메모리에 유지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać statystyk transferów. Sprawdź wolne miejsce i dostęp do folderu biblioteki. Sumy pozostają w pamięci do czasu udanego zapisu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar as estatísticas de transferência. Verifique o espaço e o acesso à pasta da biblioteca. Os totais permanecem na memória até que o salvamento funcione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить статистику передач. Проверьте свободное место и доступ к папке библиотеки. Итоги остаются в памяти до успешного сохранения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktarım istatistikleri kaydedilemedi. Kitaplık klasöründeki alanı ve erişimi denetleyin. Kayıt başarılı olana kadar toplamlar bellekte kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти статистику передавань. Перевірте вільне місце й доступ до папки бібліотеки. Підсумки залишаються в пам’яті до успішного збереження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存传输统计信息。请检查资料库文件夹的空间和访问权限。保存成功前，总计值会保留在内存中。"
          }
        }
      }
    },
