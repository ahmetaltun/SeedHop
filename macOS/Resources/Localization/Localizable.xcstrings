            "state": "translated",
            "value": "Clear search to change the whole folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra la búsqueda para modificar toda la carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacez la recherche pour modifier le dossier entier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella la ricerca per modificare l’intera cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ全体を変更するには検索をクリアしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 폴더를 변경하려면 검색을 지우세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyczyść wyszukiwanie, aby zmienić cały folder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpe a busca para alterar a pasta inteira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистите поиск, чтобы изменить всю папку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasörün tamamını değiştirmek için aramayı temizleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистіть пошук, щоб змінити всю папку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除搜索后才能更改整个文件夹。"
          }
        }
      }
