        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите плотность строк; для выбора столбцов нажмите заголовок столбца правой кнопкой"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
