    "Retry checks existing files and follows the download queue.": {
      "comment": "SeedHop macOS UI (TransferPresentation.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut versuchen prüft vorhandene Dateien und folgt der Downloadwarteschlange."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry checks existing files and follows the download queue."
          }
        },
