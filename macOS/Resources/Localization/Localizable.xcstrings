          }
        }
      }
    },
    "Prefer earlier pieces in each selected file. Otherwise, prefer rarer available pieces.": {
      "comment": "SeedHop macOS UI (ImportView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frühere Teile jeder ausgewählten Datei bevorzugen. Andernfalls seltenere verfügbare Teile bevorzugen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefer earlier pieces in each selected file. Otherwise, prefer rarer available pieces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da prioridad a las primeras piezas de cada archivo seleccionado. En caso contrario, prioriza las piezas disponibles más escasas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privilégie les premiers blocs de chaque fichier sélectionné. Sinon, privilégie les blocs disponibles les plus rares."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai priorità alle parti iniziali di ogni file selezionato. Altrimenti, preferisci le parti disponibili più rare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した各ファイルの先頭のピースを優先します。それ以外では、入手可能な希少ピースを優先します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 각 파일의 앞부분 조각을 우선합니다. 그렇지 않으면 사용 가능한 희귀 조각을 우선합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferuj początkowe części każdego wybranego pliku. W przeciwnym razie preferuj rzadsze dostępne części."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorizar os blocos iniciais de cada arquivo selecionado. Caso contrário, priorizar os blocos disponíveis mais raros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпочитать начальные части каждого выбранного файла. Иначе предпочитать более редкие доступные части."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili her dosyada önceki parçaları tercih et. Aksi halde daha nadir bulunan parçaları tercih et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надавати перевагу початковим частинам кожного вибраного файлу. Інакше надавати перевагу рідкіснішим доступним частинам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先下载所选文件前面的分片。否则，优先下载可用的稀缺分片。"
          }
        }
      }
    },
