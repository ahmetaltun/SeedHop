    "Alternative limits are not set. Click the tortoise to set a download or upload limit.": {
      "comment": "SeedHop macOS UI (LibraryStore.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternative Limits sind nicht festgelegt. Klicke auf die Schildkröte, um ein Download- oder Uploadlimit festzulegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternative limits are not set. Click the tortoise to set a download or upload limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay límites alternativos configurados. Haz clic en la tortuga para establecer un límite de descarga o subida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les limites alternatives ne sont pas définies. Cliquez sur la tortue pour définir une limite de téléchargement ou d’envoi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I limiti alternativi non sono impostati. Fai clic sulla tartaruga per impostare un limite di download o upload."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代替制限が未設定です。カメをクリックしてダウンロードまたはアップロードの制限を設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대체 제한이 설정되지 않았습니다. 거북이를 클릭하여 다운로드 또는 업로드 제한을 설정하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ustawiono alternatywnych limitów. Kliknij żółwia, aby ustawić limit pobierania lub wysyłania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os limites alternativos não estão definidos. Clique na tartaruga para definir um limite de download ou upload."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Альтернативные ограничения не заданы. Нажмите на черепаху, чтобы задать ограничение загрузки или отдачи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternatif sınırlar ayarlanmadı. İndirme veya yükleme sınırı ayarlamak için kaplumbağaya tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Альтернативні обмеження не задано. Натисніть на черепаху, щоб задати обмеження завантаження або віддавання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未设置备用限制。点击乌龟图标设置下载或上传限制。"
          }
        }
      }
    },
    "Alternative limits override scheduled caps. Scheduled pauses still apply.": {
      "comment": "SeedHop macOS UI (BandwidthSettingsView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternative Limits haben Vorrang vor geplanten Limits. Geplante Pausen gelten weiterhin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternative limits override scheduled caps. Scheduled pauses still apply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los límites alternativos prevalecen sobre los programados. Las pausas programadas siguen aplicándose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les limites alternatives remplacent les limites planifiées. Les pauses planifiées restent applicables."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I limiti alternativi prevalgono su quelli pianificati. Le pause pianificate restano valide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代替制限はスケジュールの速度制限に優先します。スケジュールによる一時停止は引き続き適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대체 제한은 예약 속도 제한보다 우선합니다. 예약된 일시 정지는 계속 적용됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternatywne limity zastępują limity harmonogramu. Zaplanowane wstrzymania nadal obowiązują."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os limites alternativos substituem os limites programados. As pausas programadas continuam válidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Альтернативные ограничения заменяют ограничения расписания. Запланированные паузы сохраняются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternatif sınırlar, zamanlanmış hız sınırlarının yerini alır. Zamanlanmış duraklatmalar geçerli kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Альтернативні обмеження замінюють обмеження розкладу. Заплановані паузи зберігаються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备用限制优先于计划限速。计划暂停仍然有效。"
          }
        }
      }
    },
