          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте другой трекер или сбросьте фильтры."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir izleyici deneyin veya filtreleri temizleyin."
          }
        },
        "uk": {
