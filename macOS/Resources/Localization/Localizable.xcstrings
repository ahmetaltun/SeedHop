    "Policy changes apply after restarting the engine.": {
      "comment": "SeedHop macOS UI (SettingsView.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richtlinienänderungen gelten nach einem Neustart der Engine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Policy changes apply after restarting the engine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de política se aplican al reiniciar el motor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications de règle s’appliquent après le redémarrage du moteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche al criterio si applicano dopo il riavvio del motore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポリシーの変更はエンジンの再起動後に適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
