          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにはファイルがすでにあります。既存ファイルの検証を有効にするか、別のフォルダを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 파일이 이미 있습니다. 기존 파일 검사를 활성화하거나 다른 폴더를 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj już istnieją pliki. Włącz sprawdzanie istniejących plików lub wybierz inny folder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existem arquivos aqui. Ative a verificação de arquivos existentes ou escolha outra pasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
