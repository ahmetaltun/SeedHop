    "Files already exist here. Enable verification of existing files or choose another folder.": {
      "comment": "SeedHop macOS UI (EngineMessage.swift).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier sind bereits Dateien vorhanden. Aktiviere die Prüfung vorhandener Dateien oder wähle einen anderen Ordner."
