          "stringUnit": {
            "state": "translated",
            "value": "トレントファイルをドロップするか、マグネットリンクを貼り付けてください。\nあとはおまかせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토렌트 파일을 끌어 놓거나 마그넷 링크를 붙여넣으세요.\n나머지는 저희가 처리할게요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upuść plik torrent lub wklej link magnet.\nResztą zajmiemy się my."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um arquivo torrent ou cole um link magnet.\nNós cuidamos do resto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите торрент-файл или вставьте magnet-ссылку.\nОстальное мы сделаем сами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent dosyası bırakın veya magnet bağlantısı yapıştırın.\nGerisini biz hallederiz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть торрент-файл або вставте magnet-посилання.\nПро решту подбаємо ми."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖入种子文件或粘贴磁力链接。\n剩下的交给我们。"
          }
        }
      }
    },
