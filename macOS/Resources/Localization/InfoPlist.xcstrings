    "NSLocalNetworkUsageDescription": {
      "comment": "System permission explanation.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop verbindet sich mit Torrent-Peers und Trackern in den von dir verwendeten Netzwerken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop connects to torrent peers and trackers on networks you use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop se conecta con pares y trackers de torrents en las redes que usas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop se connecte aux pairs et aux trackers de torrents sur les réseaux que vous utilisez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop si collega ai peer e ai tracker dei torrent sulle reti che usi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHopは使用中のネットワークでトレントのピアやトラッカーに接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop은 사용 중인 네트워크에서 토렌트 피어 및 트래커에 연결합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop łączy się z partnerami torrentów i trackerami w używanych sieciach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SeedHop se conecta a pares e rastreadores de torrents nas redes que você usa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop подключается к пирам торрентов и трекерам в используемых вами сетях."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop, kullandığınız ağlardaki torrent eşlerine ve izleyicilere bağlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop підключається до пірів торентів і трекерів у мережах, якими ви користуєтеся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SeedHop 会连接你所用网络上的种子节点和 Tracker。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
